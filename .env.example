APP_NAME=NEXUS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: use SQLite for zero-config development
DB_CONNECTION=sqlite
# Production: uncomment and fill MySQL credentials
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=nexus
# DB_USERNAME=nexus
# DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# ── Session ────────────────────────────────────────────────────────────────────
# Production: use redis for session (faster + supports horizontal scaling)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false          # Set to true in production
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false    # Set to true in production (requires HTTPS)

# ── Queues & Cache ────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync          # Change to 'redis' in production
CACHE_STORE=file               # Change to 'redis' in production

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@nexus.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ─── NEXUS Integration Keys ──────────────────────────────
# These are OPTIONAL for local dev. The app works without them.

# Meta App (Instagram + Facebook DMs)
# Get from: https://developers.facebook.com → Your App → Settings
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=nexus-verify-token
META_PAGE_TOKEN=

# OpenAI (AI order extraction from messages)
# Get from: https://platform.openai.com/api-keys
# Without this, regex fallback handles Kosovo phone/address extraction
OPENAI_API_KEY=

# WhatsApp Business API
# Get from: Meta App Dashboard → WhatsApp → Getting Started
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
